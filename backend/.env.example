# =============================================================
# LinkForge – Backend Environment Variables (example)
# Copy this to .env and fill in your values
# =============================================================

# --- PostgreSQL (Neon / Supabase) ---
DATABASE_URL=postgresql://user:password@host:5432/db

# --- MongoDB (Atlas) ---
MONGODB_URI=mongodb+srv://user:password@cluster.url/db
MONGODB_DB=linkforge_analytics

# --- Redis (Upstash) ---
REDIS_URL=rediss://default:password@host:6379

# --- IP Geolocation (ipinfo.io) ---
# Optional free token (https://ipinfo.io/signup) — 50k req/month with token, 50/day without
# IPINFO_TOKEN=

# --- Kafka (Aiven) ---
# From Aiven console > Overview > Connection information:
#   Host + Port  ->  KAFKA_BOOTSTRAP_SERVERS
#   Username     ->  KAFKA_SASL_USERNAME (default: avnadmin)
#   Password     ->  KAFKA_SASL_PASSWORD (set under Authentication > SASL > Enable)
#   CA Cert      ->  Download ca.pem and place it at KAFKA_SSL_CA_PATH
KAFKA_BOOTSTRAP_SERVERS=host.aivencloud.com:port
KAFKA_SASL_USERNAME=avnadmin
KAFKA_SASL_PASSWORD=your-password
KAFKA_SSL_CA_PATH=./ca.pem

# --- SMTP (Email) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=your.email@gmail.com
FROM_NAME=LinkForge
FRONTEND_URL=http://localhost:3000

# --- JWT ---
# REQUIRED when ENVIRONMENT=production (the default): the app refuses to boot
# without it, because a blank SECRET_KEY signs every JWT and webhook HMAC with a
# publicly known key. Generate with: openssl rand -hex 32
SECRET_KEY=run-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Refresh token lifetime. Also drives the Redis session/revocation record TTLs
# and the refresh cookie (REFRESH_COOKIE_MAX_AGE may not exceed this).
REFRESH_TOKEN_EXPIRE_DAYS=7
# The access cookie deliberately outlives ACCESS_TOKEN_EXPIRE_MINUTES so silent
# refresh can work; the refresh cookie is capped at the token's own lifetime.
ACCESS_COOKIE_MAX_AGE=604800
REFRESH_COOKIE_MAX_AGE=604800

# --- Admin bootstrap ---
# POST /api/v1/admin/seed promotes the caller to superadmin. It requires this
# shared secret via the X-Admin-Bootstrap-Token header. Leaving it EMPTY disables
# the endpoint (it returns 404) - without it, the first person to register on a
# fresh database would own the platform. Generate with: openssl rand -hex 32
ADMIN_BOOTSTRAP_TOKEN=

# --- Email verification ---
# When true, login is refused until the address is verified. Default false
# because is_verified is currently advisory and enabling it locks out every
# account registered before the check existed.
REQUIRE_EMAIL_VERIFICATION=false

# --- OAuth ---
GOOGLE_OAUTH_CLIENT_ID=your-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

GITHUB_OAUTH_CLIENT_ID=your-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-client-secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/github/callback

# --- Observability (3 layers: in-process → collector → New Relic) ---
# Layer 1 (in this app): OTel SDK records metrics/traces/logs and pushes OTLP
# to the Layer-2 collector (docker/otel-collector-config.yaml). The collector
# holds the New Relic API key, tail-samples traces, and fans out.
#   - Local:      docker compose up otel-collector  -> endpoint http://localhost:4318
#   - Production: Render collector service           -> endpoint https://<name>.onrender.com
# To push straight to New Relic without the collector:
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.nr-data.net:4318
#   OTEL_EXPORTER_OTLP_HEADERS=api-key=<your ingest key>
# Exports are fail-open: the app never blocks or crashes on telemetry.
OTLP_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=
# Fraction of spans the app emits. 1.0 = send everything and let the collector
# tail-sample (keep 100% of errors). Lower only when running direct-to-vendor.
OTEL_TRACES_SAMPLE_RATIO=1.0
